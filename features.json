  "pages": [
    {
      "name": "index.html (root)",
      "description": "Entry point - redirects to main index",
      "path": "index.html",
      "access": "public"
    },
    {
      "name": "Home",
      "description": "Landing page with categories and featured products",
      "path": "html/index.html",
      "access": "public",
      "requiresAuth": false
    },
    {
      "name": "Products",
      "description": "Product listing with filters, search, sort",
      "path": "html/products.html",
      "access": "public",
      "requiresAuth": false
    },
    {
      "name": "Product Details",
      "description": "Single product page with specs and reviews",
      "path": "html/product-detail.html",
      "parameters": "?id=productId",
      "access": "public",
      "requiresAuth": false
    },
    {
      "name": "Cart",
      "description": "Shopping cart management",
      "path": "html/cart.html",
      "access": "public",
      "requiresAuth": false
    },
    {
      "name": "Checkout",
      "description": "3-step order completion",
      "path": "html/checkout.html",
      "access": "protected",
      "requiresAuth": true,
      "steps": [
        "Shipping Information",
        "Payment Method Selection",
        "Order Confirmation"
      ]
    },
    {
      "name": "Authentication",
      "description": "Login and registration",
      "path": "html/auth.html",
      "access": "public",
      "requiresAuth": false,
      "forms": ["login", "register"]
    },
    {
      "name": "Account",
      "description": "User dashboard and profile",
      "path": "html/account.html",
      "access": "protected",
      "requiresAuth": true,
      "tabs": [
        "Dashboard",
        "Orders",
        "Wishlist",
        "Profile",
        "Addresses",
        "Security"
      ]
    },
    {
      "name": "About",
      "description": "Company information",
      "path": "html/about.html",
      "access": "public",
      "requiresAuth": false
    },
    {
      "name": "Contact",
      "description": "Contact form",
      "path": "html/contact.html",
      "access": "public",
      "requiresAuth": false
    }
  ],

