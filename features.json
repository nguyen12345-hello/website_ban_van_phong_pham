  "localStorageSchema": {
    "cart": {
      "type": "Array<CartItem>",
      "structure": "[{id, quantity, price, addedAt}, ...]"
    },
    "currentUser": {
      "type": "User|null",
      "structure": "{id, name, email, password, phone, address, createdAt, wishlist, orders}"
    },
    "users": {
      "type": "Array<User>",
      "structure": "[User, ...]"
    },
    "wishlist": {
      "type": "Array<number>",
      "structure": "[productId1, productId2, ...]"
    },
    "orders": {
      "type": "Array<Order>",
      "structure": "[{id, userId, items, totalPrice, shippingInfo, status, paymentMethod, paymentStatus, trackingNumber, createdAt, updatedAt}, ...]"
    }
  },

